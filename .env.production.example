# Variables de PRODUCTION – copier en « .env » sur le serveur (jamais dans git)
# Générer un secret : openssl rand -base64 32

# Domaine et adresse publique
SITE_DOMAIN="tsdsystems.net"
SITE_URL="https://tsdsystems.net"
# Courriel pour les certificats HTTPS (Let's Encrypt)
ACME_EMAIL="contact@tsdsystems.net"

# Base de données (DATABASE_URL est construite par docker-compose.prod.yml)
POSTGRES_USER="tsd"
POSTGRES_PASSWORD=""
POSTGRES_DB="tsd_site"

# Formulaire de contact
IP_HASH_SALT=""
RESEND_API_KEY=""
CONTACT_TO="contact@tsdsystems.net"
CONTACT_FROM="TSD Systems <site@tsdsystems.net>"

# Premier compte administrateur (seed) – 12 caractères minimum ; à vider après la mise en ligne
SEED_ADMIN_EMAIL="contact@tsdsystems.net"
SEED_ADMIN_NAME="Administrateur"
SEED_ADMIN_PASSWORD=""

# Divers
ADMIN_TIMEZONE="Africa/Bamako"
TZ="UTC"

# Sauvegardes (voir docs/SAUVEGARDES.md) – ex. « b2:tsd-sauvegardes »
BACKUP_REMOTE=""
BACKUP_CRON="30 2 * * *"
BACKUP_KEEP_LOCAL_DAYS="7"
BACKUP_KEEP_REMOTE_DAYS="30"
