generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SolutionStatus {
  AVAILABLE
  COMING_SOON
}

// Comptes qui accèdent à l'administration
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

// Sessions d'administration : le cookie contient le jeton, la base n'en garde que l'empreinte
model Session {
  id        String    @id // SHA-256 du jeton
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Tentatives de connexion (limitation des essais)
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([email, createdAt])
}

// Valeurs modifiables en FR et EN :
// - "msg.<clé>" : textes des pages (remplacent ceux de messages/*.json)
// - "contact.*", "social.*", "image.*" : coordonnées, réseaux, logos et photos (valueFr seulement)
model Setting {
  key     String @id
  valueFr String @default("") @db.Text
  valueEn String @default("") @db.Text
}

model Solution {
  id            Int            @id @default(autoincrement())
  slug          String         @unique
  name          String
  taglineFr     String         @default("") // catégorie, ex. « Gestion scolaire »
  taglineEn     String         @default("")
  summaryFr     String         @default("") @db.Text // résumé de la carte
  summaryEn     String         @default("") @db.Text
  descriptionFr String         @default("") @db.Text // description de la fiche
  descriptionEn String         @default("") @db.Text
  featuresFr    Json           @default("[]") // [{ title, text }]
  featuresEn    Json           @default("[]")
  status        SolutionStatus @default(COMING_SOON)
  logoUrl       String?
  imageUrl      String? // visuel de la fiche (capture d'écran)
  appUrl        String?
  position      Int            @default(0)
  published     Boolean        @default(true)
}

model TeamMember {
  id        Int     @id @default(autoincrement())
  name      String
  roleFr    String  @default("")
  roleEn    String  @default("")
  bioFr     String  @default("") @db.Text
  bioEn     String  @default("") @db.Text
  photoUrl  String?
  position  Int     @default(0)
  published Boolean @default(true)
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  body      String   @db.Text
  locale    String   @default("fr")
  ipHash    String   @default("") // IP hachée (SHA-256 + sel), pour limiter les envois sans stocker l'IP
  notified  Boolean  @default(false) // courriel de notification envoyé
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}
