# Copier vers .env (PowerShell : copy .env.example .env)
DATABASE_URL="postgresql://tsd:tsd_dev_password@localhost:5435/tsd_site"

# Formulaire de contact
# Sel pour hacher les adresses IP (limite d'envois) : une longue chaîne aléatoire
IP_HASH_SALT="remplacer-par-une-chaine-aleatoire"
# Notification par courriel via Resend (laisser vide = enregistrement en base seulement)
RESEND_API_KEY=""
CONTACT_TO="contact@tsdsystems.net"
# Expéditeur : adresse d'un domaine vérifié dans Resend
CONTACT_FROM="TSD Systems <site@tsdsystems.net>"

# Images téléversées (dossier persistant ; volume Docker en production)
UPLOAD_DIR="./uploads"

# Premier compte administrateur, créé par « npx prisma db seed » si aucun compte n'existe (12 caractères minimum)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME="Administrateur"
SEED_ADMIN_PASSWORD=""

# Fuseau horaire des dates affichées dans /admin
ADMIN_TIMEZONE="Africa/Bamako"
